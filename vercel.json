{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api?__path=health"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__path=$1"
    }
  ]
}
