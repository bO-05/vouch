# ==========================================
# Vouch Protocol Environment Variables
# DEV Weekend Challenge: Generosity Edition
# ==========================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Google AI Studio (Gemini API)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# ElevenLabs Voice Synthesis API
# Get a key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# Solana Devnet Cluster RPC
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# Production Authority & Persistent Storage (Optional)
# In production, provide an exported 64-byte array JSON string for the authority keypair:
SOLANA_AUTHORITY_SECRET_KEY=
# Custom persistent directory for db.json and audio cache (e.g. /data on Render or Docker volume):
DATA_DIR=

# Client Frontend Overrides (Vite SPA)
# Use when frontend is hosted separately from backend (e.g., Vercel frontend + Render backend):
VITE_API_URL=
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
